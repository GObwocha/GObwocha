# Public Browser-Safe Environment Variables
# Copy this file to .env.local for local development (never commit .env.local).
VITE_SITE_URL=https://gobwocha.vercel.app
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# EmailJS Client Credentials (for receiving email enquiries in Gmail without custom domain)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Server-Only Environment Variables
# SECURITY WARNING: Never prefix server secrets (such as SUPABASE_SERVICE_ROLE_KEY)
# with VITE_ or expose them to browser client code.
# SUPABASE_SERVICE_ROLE_KEY=
